# ===== أسرار البيئة (انسخه إلى .env أو إلى Replit Secrets) =====
# مفتاح OpenAI — يوضع في Replit Secrets باسم OPENAI_API_KEY
# لا تضعه أبداً في كود المتصفح ولا ترفعه إلى GitHub.
OPENAI_API_KEY=sk-...your-key-here...

# اختياري: المنفذ (Replit يحدّده تلقائياً)
PORT=3000

# اختياري: نماذج OpenAI (القيم الافتراضية جيدة)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
