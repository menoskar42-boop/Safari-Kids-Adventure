# إعداد Replit لتشغيل خادم Safari Kids Adventure
run = "npm install && npm start"
entrypoint = "server/index.js"
modules = ["nodejs-18", "web"]

hidden = [".config", "node_modules", ".upm"]

[nix]
channel = "stable-25_05"

[env]
PORT = "5000"

[deployment]
run = ["sh", "-c", "npm install && npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
