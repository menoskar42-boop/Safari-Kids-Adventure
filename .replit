# إعداد Replit لتشغيل خادم Safari Kids Adventure
run = "npm install && npm start"
entrypoint = "server/index.js"
modules = ["nodejs-18", "web"]

hidden = [".config", "node_modules", ".upm"]

[nix]
channel = "stable-25_05"

[env]
PORT = "5000"

[deployment]
run = ["sh", "-c", "npm install && npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
